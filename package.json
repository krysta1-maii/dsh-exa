{
  "name": "dsh-exa",
  "version": "0.4.2",
  "description": "Exa semantic search and URL reading tools for DeepSeek Harness, with active-key filtering, multi-key priority or round-robin routing, automatic deactivation on HTTP 402, key management on the Plugins page, and a shortcut to Exa Billing. The built-in web_search is never replaced.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tools": "./src/tools-entry.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "icon.svg"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0",
      "dshReleases": {
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.2": "source-checked"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/tools-entry.js && node --check src/lib.js && node --check src/state.js && node --check src/key-manager.js && node --check src/exa-client.js && node --check src/tools.js && node --check src/backend.js && node --check src/client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "exa",
    "web-search",
    "semantic-search",
    "tool"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
